# Copy to .env and fill in. .env is gitignored - never commit real credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Read-only connection to the core banking database.
CBA_DB_NAME=dashmfb-cba-mcs
CBA_DB_USER=robot
CBA_DB_PASSWORD=
CBA_DB_HOST=172.22.0.93
CBA_DB_PORT=3306

# Production only (ignored while DJANGO_DEBUG=True)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local development only - shows fabricated data instead of the real database.
# Never set this on the server.
USE_SAMPLE_DB=False

# Server binding. 8000-8002 are taken by other apps on the VM.
DJANGO_BIND_HOST=0.0.0.0
DJANGO_PORT=8500
DJANGO_THREADS=8

# Reverse proxy that is allowed to set X-Forwarded-* (IIS on this machine).
DJANGO_TRUSTED_PROXY=127.0.0.1
